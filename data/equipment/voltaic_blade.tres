[resource]
script = ExtResource("1_item")
id = &"voltaic_blade"
display_name = "Voltaic Blade"
role_label = "BLEED + SHOCK"
combat_promise = "Every hit applies 1 Bleed for 4s; +20% damage against Shocked enemies."
