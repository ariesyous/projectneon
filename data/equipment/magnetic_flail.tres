[gd_resource type="Resource" script_class="EquipmentDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/equipment/equipment_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://scripts/equipment/equipment_modifier_definition.gd" id="2_modifier"]
[ext_resource type="Texture2D" path="res://assets/ui/equipment/icons/magnetic_flail.png" id="9_icon"]

[sub_resource type="Resource" id="Modifier_environment_knockback"]
script = ExtResource("2_modifier")
id = &"magnetic_flail_environment_knockback"
