operation = 1
amount = 0.20

[sub_resource type="Resource" id="Modifier_environment_damage"]
script = ExtResource("2_modifier")
id = &"magnetic_flail_environment_damage"
stat_id = &"environmental_collision_damage"
operation = 1
amount = 0.10

[resource]
script = ExtResource("1_item")
id = &"magnetic_flail"
display_name = "Magnetic Flail"
icon = ExtResource("9_icon")
description = "A Tech/Knockback bridge that amplifies environmental chains."
tags = Array[StringName]([&"TECH", &"KNOCKBACK"])
modifiers = Array[EquipmentModifierDefinition]([SubResource("Modifier_environment_knockback"), SubResource("Modifier_environment_damage")])
major_effects = PackedStringArray("+20% environmental knockback", "+10% environmental collision damage")
