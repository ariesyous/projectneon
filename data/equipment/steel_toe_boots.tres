[gd_resource type="Resource" script_class="EquipmentDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/equipment/equipment_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://scripts/equipment/equipment_modifier_definition.gd" id="2_modifier"]
[ext_resource type="Texture2D" path="res://assets/ui/equipment/icons/steel_toe_boots.png" id="9_icon"]

[sub_resource type="Resource" id="Modifier_movement"]
script = ExtResource("2_modifier")
id = &"steel_toe_boots_movement"
stat_id = &"movement_speed"
operation = 1
amount = 0.10

[sub_resource type="Resource" id="Modifier_environment_damage"]
script = ExtResource("2_modifier")
id = &"steel_toe_boots_environment_damage"
stat_id = &"environmental_collision_damage"
operation = 1
amount = 0.15

[resource]
script = ExtResource("1_item")
id = &"steel_toe_boots"
display_name = "Steel-Toe Boots"
icon = ExtResource("9_icon")
description = "Mobile street hardware for turning scenery into a weapon."
tags = Array[StringName]([&"KNOCKBACK", &"MOBILITY"])
modifiers = Array[EquipmentModifierDefinition]([SubResource("Modifier_movement"), SubResource("Modifier_environment_damage")])
major_effects = PackedStringArray("+10% movement speed", "+15% environmental collision damage")
