[gd_resource type="Resource" script_class="DistrictLoopDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/run/district_loop_definition.gd" id="1_loop"]

[resource]
script = ExtResource("1_loop")
id = &"wp02_district_loop"
lap_count = 3
blocks_per_lap = 3
push_heat_delta = 6
pressure_gain_multipliers = PackedFloat32Array(1, 1.15, 1.3)
reward_quality_tier_bonuses = PackedInt32Array(0, 1, 2)
modifier_ids = Array[StringName]([&"street_watch", &"rising_pressure", &"boss_commitment"])
modifier_labels = PackedStringArray("STREET WATCH", "RISING PRESSURE", "BOSS COMMITMENT")
risk_labels = PackedStringArray("BASELINE DISTRICT RISK", "HIGHER ENEMY PRESSURE", "FINAL LAP - NO ROUTINE EXTRACTION")
next_threat_labels = PackedStringArray("STREET PATROLS", "VIPER ENFORCER", "THE VIPER")
