[gd_resource type="Resource" script_class="EncounterDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://data/encounters/encounter_definition.gd" id="1_encounter"]
[ext_resource type="Script" path="res://data/encounters/encounter_spawn_entry.gd" id="2_spawn"]

[sub_resource type="Resource" id="Spawn_street"]
script = ExtResource("2_spawn")
actor_id = &"street_punk"
minimum_count = 1
maximum_count = 30
budget_cost = 1

[sub_resource type="Resource" id="Spawn_bat"]
script = ExtResource("2_spawn")
actor_id = &"bat_thug"
minimum_count = 0
maximum_count = 3
budget_cost = 1

[resource]
script = ExtResource("1_encounter")
id = &"alley_scuffle"
display_name = "Alley Scuffle"
minimum_heat_tier = 0
minimum_night_pressure = 0.0
base_spawn_budget = 3
maximum_concurrent_enemies = 3
initial_spawn_delay_seconds = 3.0
spawn_interval_seconds = 12.0
allowed_enemy_ids = Array[StringName]([&"street_punk", &"bat_thug"])
spawn_entries = Array[EncounterSpawnEntry]([SubResource("Spawn_street"), SubResource("Spawn_bat")])
spawn_position_ids = Array[StringName]([&"lane_0", &"lane_1", &"lane_2"])
reward_table_ids = Array[StringName]([&"street_cache"])
completion_condition = &"all_required_defeated"
heat_gain_on_completion = 4
elite_eligible = false
boss = false
environment_action_id = &"fire_hydrant"
